{
  "$name": "VeraFlow",
  "$description": "Semantic design tokens. Light appearance is 'Chalk', dark is 'Slate'. Screens reference names, never values.",
  "color": {
    "background":       { "light": "#F3F4F6", "dark": "#1B1D22" },
    "surface":          { "light": "#FFFFFF", "dark": "#23262C" },
    "surfaceRaised":    { "light": "#EDEFF2", "dark": "#2A2E35" },
    "playerBar":        { "light": "#FFFFFF", "dark": "#202329" },

    "separator":        { "light": "#EBEDF0", "dark": "#2B2F36" },
    "border":           { "light": "#E1E4E9", "dark": "#32363E" },
    "borderStrong":     { "light": "#D3D8DE", "dark": "#3C414A" },

    "textPrimary":      { "light": "#16181C", "dark": "#F2F4F7" },
    "textSecondary":    { "light": "#4A5058", "dark": "#B4BAC4" },
    "textTertiary":     { "light": "#5F666F", "dark": "#868E9A" },
    "iconPrimary":      { "light": "#333941", "dark": "#DCE0E7" },

    "accent":           { "light": "#2E5A8A", "dark": "#7EB6DE" },
    "onAccent":         { "light": "#F3F4F6", "dark": "#1B1D22" },

    "danger":           { "light": "#B3261E", "dark": "#F0796B" },
    "dangerMuted":      { "light": "#8C2019", "dark": "#F2A196" },
    "success":          { "light": "#2E7D4F", "dark": "#8FC79B" },
    "successFill":      { "light": "#E3F0E6", "dark": "#28382F" },

    "nowPlayingFill":   { "light": "#EAF1F8", "dark": "#232A33" },
    "nowPlayingBorder": { "light": "#C3D6E8", "dark": "#3A4654" },

    "waveformPlayed":   { "light": "#9AA1AA", "dark": "#4A505A" },
    "waveformIdle":     { "light": "#CFD4DA", "dark": "#3A4049" },
    "waveformHead":     { "light": "#16181C", "dark": "#F2F4F7" },

    "speaker": [
      { "light": "#2E5A8A", "dark": "#7EB6DE" },
      { "light": "#1E6E62", "dark": "#8FC79B" },
      { "light": "#8A5A1E", "dark": "#E0A86A" },
      { "light": "#6B4FA8", "dark": "#BFA6E8" },
      { "light": "#9A3A6B", "dark": "#E79CC2" }
    ]
  },
  "font": {
    "family": {
      "serif": "Newsreader",
      "sans": "Manrope"
    },
    "style": {
      "screenTitle":     { "family": "serif", "size": 34,   "weight": 400, "tracking": -0.5,  "lineSpacing": 0, "dynamicType": "largeTitle" },
      "recordingTitle":  { "family": "serif", "size": 29,   "weight": 400, "tracking": -0.45, "lineSpacing": 3, "dynamicType": "title" },
      "cardTitle":       { "family": "serif", "size": 20,   "weight": 400, "tracking": -0.2,  "lineSpacing": 2, "dynamicType": "headline" },
      "summaryBody":     { "family": "serif", "size": 17,   "weight": 400, "tracking": 0,     "lineSpacing": 6, "dynamicType": "body" },
      "transcriptBody":  { "family": "serif", "size": 16.5, "weight": 400, "tracking": 0,     "lineSpacing": 6, "dynamicType": "body" },
      "reassurance":     { "family": "serif", "size": 14.5, "weight": 400, "italic": true,    "lineSpacing": 3, "dynamicType": "footnote" },
      "timerDisplay":    { "family": "serif", "size": 62,   "weight": 400, "tracking": -1.2,  "tabularFigures": true, "dynamicType": "largeTitle" },
      "sectionLabel":    { "family": "sans",  "size": 10.5, "weight": 600, "tracking": 1.7,   "uppercase": true, "dynamicType": "caption2" },
      "tabLabel":        { "family": "sans",  "size": 12,   "weight": 700, "tracking": 1.2,   "uppercase": true, "dynamicType": "caption" },
      "speakerLabel":    { "family": "sans",  "size": 11.5, "weight": 700, "tracking": 0.7,   "uppercase": true, "dynamicType": "caption" },
      "rowLabel":        { "family": "sans",  "size": 14.5, "weight": 500, "dynamicType": "body" },
      "body":            { "family": "sans",  "size": 14,   "weight": 400, "lineSpacing": 4, "dynamicType": "subheadline" },
      "snippet":         { "family": "sans",  "size": 13,   "weight": 400, "lineSpacing": 4, "dynamicType": "footnote" },
      "meta":            { "family": "sans",  "size": 11.5, "weight": 400, "tabularFigures": true, "dynamicType": "caption" },
      "buttonLabel":     { "family": "sans",  "size": 15.5, "weight": 700, "tracking": 0.15, "dynamicType": "body" }
    }
  },
  "space": {
    "gutter": 20,
    "gutterTight": 16,
    "cardPaddingH": 16,
    "cardPaddingV": 15,
    "listGap": 10,
    "sectionGap": 18,
    "bottomInset": 30
  },
  "radius": {
    "field": 12,
    "block": 14,
    "card": 16,
    "panel": 18,
    "pill": 999
  },
  "metric": {
    "minHit": 44,
    "iconButton": 44,
    "primaryPillHeight": 56,
    "hairline": 1,
    "waveformBarWidth": 3,
    "waveformBarGap": 2
  },
  "motion": {
    "pulse": { "duration": 1.7, "curve": "easeInOut", "repeats": true, "autoreverses": true },
    "transcriptScroll": { "duration": 0.28, "curve": "easeOut" },
    "tabSwitch": { "duration": 0.2, "curve": "easeInOut" }
  }
}
